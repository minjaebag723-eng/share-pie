# ── 복사해서 .env 로 저장하세요 (.env 는 절대 Git에 올리지 않기) ──

# Kiln API (FuriosaAI NPU · qwen3-32b)
KILN_API_KEY=
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_MODEL=qwen3-32b
# auto: tool calling 먼저 → 안 되면 JSON 모드 자동 전환 / tools / json
KILN_TOOL_MODE=auto
# gpt-oss 계열 전용 추론 강도 (qwen3는 안 보냄 — 대신 /no_think 로 긴 사고를 끔)
KILN_REASONING_EFFORT=low
# 이의제기 판정처럼 어려운 단계만 더 생각하게 (qwen3는 이 단계만 사고 모드 켬)
KILN_REASONING_EFFORT_THINK=medium
# 1: KILN_MODEL(qwen3-32b)만 사용 (없으면 다른 모델로 바꾸지 않음) · 0: 쓸 수 있는 모델 자동 선택
KILN_MODEL_STRICT=1
# live: Kiln 사용 / mock: 키 없이 규칙 기반 (키가 없으면 자동 mock)
# 키를 아직 못 받았으면 이 줄을 LLM_MODE=mock 으로 두세요
LLM_MODE=live
# Pie 채팅 방식: agent(대화형 · 모델이 도구를 골라 씀, 기본) / pipeline(단계 고정 · 토큰 적음)
PIE_CHAT=agent

# 에너지 추정 가정 (README에 그대로 인용) — RNGD TDP 150W, 카드 수는 대회 측 확인 후 수정
NPU_POWER_WATTS=150
NPU_COUNT=1

# ── 인터넷 상품 검색 (넣은 것만 자동으로 켜짐. 하나도 없으면 Share Pie 샘플 상품만 검색) ──
# 네이버 검색 API: https://developers.naver.com/apps/#/register → 사용 API '검색' → 환경 'WEB 설정' URL http://localhost
#   (무료, 하루 25,000회 · 쇼핑 최저가/판매처 + 뉴스/블로그 문맥)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Serper (구글 쇼핑·구글 검색): https://serper.dev 가입 → API Key · 가입 시 2,500회 무료, 카드 불필요
#   (네이버 키 발급이 안 될 때 대체제 — 쿠팡·컬리·11번가 등 여러 쇼핑몰 가격)
SERPER_API_KEY=
# SerpApi(serpapi.com, 키 64자)를 쓰면 여기에 — 실제 키는 .env에만 (이 파일은 GitHub에 올라가요)
SERPAPI_API_KEY=

# Tavily 웹 검색: https://app.tavily.com 가입 → API Key (tvly-...) · 무료 월 1,000회, 카드 불필요
#   (공식몰·쿠팡 상품 페이지·편의점 기사 등 일반 웹)
TAVILY_API_KEY=
# 쿠팡 파트너스 API: 누적 판매 15만원 이상 최종 승인 후에만 발급 (없으면 비워 두기)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 블록체인: mock(로컬 시뮬레이션) / bsc(BNB Smart Chain Testnet)
CHAIN_MODE=mock
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_CHAIN_ID=97
BSC_EXPLORER=https://testnet.bscscan.com
# 에이전트 지갑 = 컨트랙트 배포 지갑 (테스트넷 전용 새 계정! 실제 자산 있는 지갑 절대 금지)
AGENT_PRIVATE_KEY=
LEDGER_ADDRESS=
TOKEN_ADDRESS=
LEDGER_DEPLOY_BLOCK=0

# 허용 가맹점 (쉼표 구분) — 목록 밖 가맹점 결제는 중단 + 체인 기록
ALLOWED_MERCHANTS=Share Pie 공동구매,Share Pie 배달 공동주문,네이버,스마트스토어,쿠팡,11번가,G마켓,옥션,SSG,신세계,롯데,컬리,오아시스,GS SHOP,GS25,CU,세븐일레븐,이마트,홈플러스,CJ,공식몰,공식스토어
# 전원 예치 후 결제자 지급 전 이의제기 가능 시간(초) — mock 체인용. 실제 체인은 ShareLedger.setDisputeWindow
DISPUTE_WINDOW_SEC=180
# PIE 충전량과 충전 간격(초)
CHARGE_AMOUNT=100000
CHARGE_COOLDOWN_SEC=60
# (예전 후불 방식 단위 · 지금은 표시에만) AI 전용 페이: 1 AI원 = Kiln 토큰 1개 × 이 값 (Pie Pay에서 1 AI원 = 1 PIE로 송금)
AI_WON_PER_TOKEN=1
# 사용료를 받는 지갑 (비우면 에이전트 지갑)
AI_FEE_WALLET=

# ── 위치 (GPS → 동네 이름) ── 비워 두면 OpenStreetMap(키 불필요) 사용
# 카카오를 쓰려면 https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_KEY=


# ── 메일 (회원가입 인증번호 · 비밀번호 재설정) ──
# 비워 두면 '개발 모드': 인증번호가 서버 창과 앱 화면에 표시돼요 (시연용). 실제 메일을 보내려면:
# Gmail: 구글 계정 → 보안 → 2단계 인증 켜기 → '앱 비밀번호' 16자리 발급
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# auto(기본): SMTP가 없을 때만 화면에 인증번호 표시 / 0: 절대 표시 안 함
MAIL_DEV_ECHO=auto


# 프론트를 다른 포트에서 띄울 때만 필요 (백엔드가 frontend/ 를 직접 서빙하면 불필요)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://localhost:5500

# ── 소셜 로그인 (docs/DEPLOY.md 1-2) · 비어 있는 회사 버튼은 '준비 중' 안내만 떠요 ──
# 각 사 콘솔에 등록할 콜백 주소: <서버 주소>/api/auth/social/kakao|naver|google|apple/callback
PUBLIC_BASE_URL=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 계정·정산 기록 저장 위치 (비우면 ~/.sharepie-data — 새 zip을 다른 폴더에 풀어도 계정이 유지돼요)
DATA_DIR=

# ── AI 요금제 (Claude 벤치마킹: Free → Pie Pro → Pie Max 5x → Pie Max 20x) ──
# 쓴 만큼 정산하지 않고, 요금제가 5시간 세션 한도·주간 한도(Kiln 실측 토큰)를 정한다. 기준은 Pro, Free = 1/5, Max = 5배·20배.
AI_SESSION_HOURS=5
AI_WEEK_DAYS=7
AI_PRO_SESSION_TOKENS=125000
AI_PRO_WEEK_TOKENS=500000
AI_PRICE_PRO=4900
AI_PRICE_MAX=24500
AI_PRICE_MAX20=49000

# ── 베타 데이터 수집 (agent/beta.py) ──
# 모든 Kiln 기록에 붙는 앱 버전. beta로 시작하면 베타 미션·대화 제공 동의·답 평가가 켜진다. 정식 배포는 1.0 처럼
APP_VERSION=beta-1
# 베타 동안 구독 없는 사용자에게 줄 한도 (pro 권장 — 한도 때문에 데이터가 끊기지 않게). 비우면 Free 한도
BETA_PLAN=pro
# 학습·평가 후보 내보내기 권한 (관리자 이메일, 쉼표로 여러 명) 또는 키
BETA_ADMIN_EMAILS=sharepie0@gmail.com
BETA_EXPORT_KEY=
# 사용자 id를 되돌릴 수 없게 바꾸는 값 (배포마다 바꿀 것)
BETA_SALT=change-me

# ── 베타 서버 (deploy/README.md) — deploy.asgi로 켜면 괄호 안 값이 기본. 로컬 실행은 적지 않아도 됨 ──
# BETA_DATA_DIR=            베타 데이터 폴더 (비우면 DATA_DIR/beta) — 이 폴더만 보내면 됨
# BETA_SNAPSHOT_SEC=600     폴더의 보고서·목록 갱신 간격(초)
# STORE_SAVE_DELAY=1        db.json 저장을 모으는 간격(초)
# KILN_MAX_CONCURRENCY=24   Kiln 동시 호출 상한 · KILN_QUEUE_WAIT=20 상한에서 기다리는 초
# SERVER_THREADS=200        요청 처리 스레드
# ── 실제 체인 동시 접속 (CHANGES-beta-server.md) — 기본 켜짐, 0이면 예전 방식 ──
# CHAIN_TX_PIPELINE=1       에이전트 트랜잭션 여러 건 동시에 (확정 대기를 잠금 밖에서)
# GAS_DRIP_ASYNC=1          지갑 등록 때 가스 지급을 뒤에서
# CHAIN_WATCH=1             열린 정산은 체인 감시가 읽음 (새로고침은 저장된 상태만) · CHAIN_WATCH_SEC=5
# CHAIN_MAX_GAS_GWEI=50     가스 가격 상한 (0 = 없음)
