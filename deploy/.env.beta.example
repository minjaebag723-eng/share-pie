# ── Share Pie 베타 서버 .env ──
# 이 파일을 프로젝트 맨 위 폴더에 .env 로 복사해 빈 칸을 채워요. (.env는 GitHub에 올리지 않기)
# 블록체인 설정은 완성본의 .env.example에 있는 값을 블록체인 담당에게 받아 아래 [블록체인]에 붙여 넣어요.

# [주소] 도메인이 있으면 도메인 → HTTPS 인증서 자동. 없으면 서버 공인 IP를 점 대신 - 로: 12-34-56-78.sslip.io
SITE_ADDRESS=beta.example.com
# 소셜 로그인 콜백 등에 쓰는 공개 주소 (https 포함)
PUBLIC_BASE_URL=https://beta.example.com

# [앱 버전] 베타는 beta-1 · 정식은 1.0 — 같은 데이터 폴더에 쌓이면 보고서가 버전별로 비교
APP_VERSION=beta-1

# [AI · Kiln] 대회 키 · 모델 고정
LLM_MODE=live
KILN_API_KEY=
KILN_MODEL=qwen3-32b
KILN_MODEL_STRICT=1
# 블록체인 담당 권장 (감면 해석·판정 안정 — 스모크 테스트가 확인)
KILN_TOOL_MODE=json

# [쇼핑 검색] SerpApi(serpapi.com) 키 — 비우면 인터넷 상품 검색 꺼짐 (Serper를 쓰면 SERPER_API_KEY)
SERPAPI_API_KEY=
# Kiln 동시 호출 상한 (팀 키 한도에 맞춰 조절) · 상한에서 기다리는 최대 초 (넘으면 규칙 기반으로 먼저 답함)
KILN_MAX_CONCURRENCY=24
KILN_QUEUE_WAIT=20

# [블록체인] 베타 체인 모드 — deploy/README.md 8번
#   mock : 가스비 0 (데이터 수집만 할 때)
#   bsc  : 실제 체인 (이름은 호환용 — 아래 값은 Sepolia). AGENT_PRIVATE_KEY만 블록체인 담당에게 직접 받아 채우기
CHAIN_MODE=mock
BSC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BSC_CHAIN_ID=11155111
BSC_EXPLORER=https://sepolia.etherscan.io
LEDGER_ADDRESS=0xF297240957c3aB10458Dc1A4C6eC2eA18292529E
TOKEN_ADDRESS=0xF5cB871A8890bd1D34bf36E749F012D95589E0fD
LEDGER_DEPLOY_BLOCK=11801645
AGENT_PRIVATE_KEY=
# 컨트랙트 이의제기 기간과 같아야 함 (스모크 테스트가 확인)
DISPUTE_WINDOW_SEC=180
# 가스: 새 지갑 자동 지급(ETH) · 시세 배수 · 가격 상한(gwei, 시세가 튀어도 지갑이 바닥나지 않게) · 확정 대기(초)
GAS_DRIP_ETH=0.002
GAS_PRICE_MULTIPLIER=2
CHAIN_MAX_GAS_GWEI=50
CHAIN_TX_TIMEOUT_SEC=300
# 동시 접속 (0으로 바꾸면 예전 방식): 트랜잭션 여러 건 동시에 · 가스 지급 뒤에서 · 체인 감시(새로고침이 체인을 안 읽음)
CHAIN_TX_PIPELINE=1
GAS_DRIP_ASYNC=1
CHAIN_WATCH=1
CHAIN_WATCH_SEC=5
# 에이전트 지갑 감시: 이 잔액(ETH) 밑이면 경고 · 확인 간격(초) · 4명 정산 1건 가스(실측)
CHAIN_MIN_BALANCE=0.05
CHAIN_MONITOR_SEC=60
CHAIN_GAS_PER_SETTLEMENT=1500000

# [베타 데이터]
BETA_PLAN=pro
BETA_ADMIN_EMAILS=
# 긴 무작위 값 두 개: python -c "import secrets;print(secrets.token_hex(16))"
BETA_EXPORT_KEY=
BETA_SALT=
# 데이터 폴더 보고서·목록 갱신 간격(초)
BETA_SNAPSHOT_SEC=600

# [데이터 위치] 도커면 비워 두기 (도커가 data/ · beta-data/ 폴더로 연결). 도커 없이면 절대 경로로
DATA_DIR=
BETA_DATA_DIR=

# [서버] db.json 저장 모으는 간격(초) · 요청 처리 스레드 수
STORE_SAVE_DELAY=1
SERVER_THREADS=200

# [회원가입 메일] 비워 두면 인증번호가 가입 화면에 바로 보여요(아무 이메일로 가입 가능). 실제 메일은 docs/DEPLOY.md 1-1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
