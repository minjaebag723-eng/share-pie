# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요. (.env는 절대 커밋하지 않기)
KILN_API_KEY=sk-bk-여기에_발급받은_키
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_MODEL=gpt-oss-120b

PORT=3000

# 블록체인 (Sepolia 테스트넷 전용) — 셋 중 하나라도 비어 있으면 MOCK 모드로 동작
# RPC: Alchemy/Infura 무료 계정의 Sepolia 주소 (예: https://eth-sepolia.g.alchemy.com/v2/...)
BLOCKCHAIN_RPC_URL=
# contracts 폴더에서 npm run deploy:sepolia 실행 후 출력되는 주소
CONTRACT_ADDRESS=
# ⚠️ 새로 만든 테스트 전용 지갑의 비밀키만. 실제 자산이 있는 지갑 절대 금지
DEPLOYER_PRIVATE_KEY=
# Pie 에스크로가 정산금을 지급할 테스트 결제처 주소 (아무 테스트 지갑 주소)
MERCHANT_ADDRESS=

# Shopping 모듈 (SerpApi Google Shopping) — https://serpapi.com/manage-api-key
SHOPPING_API_KEY=여기에_SerpApi_키
